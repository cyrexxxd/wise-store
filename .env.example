# Скопировать в .env рядом (файл в git не идёт) и подставить свои значения.

# Базовый URL публичного каталога бэкенда (CatStore.Api PublicCatalogController).
# Публичный ключ runtimeConfig — уходит в клиентский бандл, но это не секрет:
# эндпоинт анонимный и сам объявляет CORS только на витрину (см. Program.cs бэкенда).
NUXT_PUBLIC_CATALOG_API_BASE=http://localhost:5169/api/catalog

# POST /api/orders — тоже анонимный публичный эндпоинт (PublicOrdersController), тот же принцип.
NUXT_PUBLIC_ORDERS_API_BASE=http://localhost:5169/api/orders
