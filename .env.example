# Скопировать в .env рядом (файл в git не идёт) и подставить свои значения.
# На Render эти же переменные задаются в Environment сервиса.

# Ключ магазина EasyDonate (панель → магазин → «Ключ»). СЕКРЕТ: только на сервере.
NUXT_EASYDONATE_SHOP_KEY=

# ID сервера в EasyDonate, на который выдаются покупки (CAT).
NUXT_EASYDONATE_SERVER_ID=142066

# Адрес сайта — сюда EasyDonate вернёт покупателя после оплаты (/success).
NUXT_PUBLIC_SITE_URL=https://wisepvp.net

# Курс для подписи «≈ N ₸» под ценой в рублях.
NUXT_PUBLIC_KZT_PER_RUB=5.3
