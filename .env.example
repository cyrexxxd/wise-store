# Скопировать в .env рядом (файл в .gitignore) и подставить свои значения.
# На Render эти же переменные задаются в Environment сервиса. ПАРОЛИ И СТРОКУ БД — ТОЛЬКО ТАМ.

# Robokassa.kz → карточка магазина → Технические настройки.
NUXT_ROBOKASSA_LOGIN=
NUXT_ROBOKASSA_PASSWORD1=
NUXT_ROBOKASSA_PASSWORD2=
# алгоритм расчёта хэша, выбранный в технических настройках: md5 | sha256
NUXT_ROBOKASSA_HASH=sha256
# 1 — тестовый режим (тестовые пароли из того же раздела), 0 — боевые платежи
NUXT_ROBOKASSA_TEST=1

# Postgres для заказов и очереди выдачи (Neon: Connection string, с sslmode=require).
NUXT_DATABASE_URL=

# Токен плагина WiseDelivery на сервере CAT (заголовок X-Server-Token), 32+ случайных символов.
# Тот же — в plugins/WiseDelivery/config.yml на сервере.
NUXT_DELIVERY_SERVER_TOKEN=

# Адрес сайта (SuccessURL/FailURL в кабинете Robokassa: /success и /fail).
NUXT_PUBLIC_SITE_URL=https://wisepvp.net

# Курс для подсказки «≈ N ₽» под ценой в тенге.
NUXT_PUBLIC_KZT_PER_RUB=5.3
