# Скопировать в .env рядом (файл в .gitignore) и подставить свои значения.
# На Render эти же переменные задаются в Environment сервиса. ПАРОЛИ И СТРОКУ БД — ТОЛЬКО ТАМ.

# Robokassa.kz → карточка магазина → Технические настройки.
NUXT_ROBOKASSA_LOGIN=
NUXT_ROBOKASSA_PASSWORD1=
NUXT_ROBOKASSA_PASSWORD2=
# алгоритм расчёта хэша, выбранный в технических настройках: md5 | sha256
NUXT_ROBOKASSA_HASH=sha256
# 1 — тестовый режим (тестовые пароли из того же раздела), 0 — боевые платежи
NUXT_ROBOKASSA_TEST=1

# Секрет HMAC номера телефона для лимита «счетов на номер» (в базе — только хэш номера). ОБЯЗАТЕЛЕН:
# без него оплата Kaspi скрыта. Задаётся один раз и больше не меняется — иначе хэши старых счетов не совпадут.
# На проде — то же значение, которым хэшировались номера раньше (секрет вебхука прежнего Kaspi-провайдера).
NUXT_PHONE_HASH_SECRET=

# Kaspi Pay от имени кассира: все строки печатает  node scripts/kaspipos-login.mjs  (вход по SMS на номер кассира).
# Номером кассира больше нигде не входить — вход в настоящем приложении выбьет эту сессию.
NUXT_KASPIPOS_DEVICE_ID=
NUXT_KASPIPOS_INSTALL_ID=
NUXT_KASPIPOS_PRIVATE_KEY=
NUXT_KASPIPOS_TOKEN_SN=
NUXT_KASPIPOS_SECRET=
NUXT_KASPIPOS_PROFILE_ID=
# Kaspi поднял минимальную версию приложения (ошибка OldVersionToUpdate) — поднять здесь, без правки кода.
NUXT_KASPIPOS_APP_VERSION=26.0921
NUXT_KASPIPOS_APP_BUILD=1115

# Postgres для заказов и очереди выдачи (Neon: Connection string, с sslmode=require).
NUXT_DATABASE_URL=

# Вебхук канала Discord для уведомлений владельцу: оплаты и тревоги (сессия кассира, возвраты, неверная сумма).
# Канал → Интеграции → Вебхуки → Копировать URL. Пусто — уведомления выключены. Секрет: только в env.
NUXT_DISCORD_WEBHOOK_URL=

# Токен плагина WiseDelivery на сервере CAT (заголовок X-Server-Token), 32+ случайных символов.
# Тот же — в plugins/WiseDelivery/config.yml на сервере.
NUXT_DELIVERY_SERVER_TOKEN=

# Адрес сайта (SuccessURL/FailURL в кабинете Robokassa: /success и /fail).
NUXT_PUBLIC_SITE_URL=https://wisepvp.net

# Курс для подсказки «≈ N ₽» под ценой в тенге.
NUXT_PUBLIC_KZT_PER_RUB=5.3
